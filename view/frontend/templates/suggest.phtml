 *
 * Search box suggestions: products (close spellings when none match, said so),
 * categories, brands, posts and pages, logged terms, "View all results";
 * popular searches for an empty box. Empty output hides it (`:not(:empty)`).
 *
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Zero\Core\ViewModel\SearchSuggest $viewModel
 * @var \Zero\Search\ViewModel\Search $search
 */
$viewModel = $block->getData('viewModel');
$search = $block->getData('search');
$query = $viewModel->getQueryText();
$popular = trim($query) === '' ? $search->popular() : [];
$suggestions = $query !== '' ? $viewModel->getSuggestions() : [];
$products = $query !== '' ? $viewModel->getMatchingProducts() : [];
$more = $query !== '' ? $search->more($search::SUGGEST_LIMIT) : [];
$showAllResultsLink = $query !== '' && ($suggestions || $products || $more || !$viewModel->isQueryTooShort());
$heading = 'menu-title px-2 pt-2 pb-1 text-xs font-medium uppercase tracking-wide text-base-content/60';
?>
<?php if ($popular): ?>
    <ul class="menu menu-sm w-full rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Popular searches')) ?>" data-zero-search-popular>
        <li class="<?= /* @noEscape */ $heading ?>"><?= $escaper->escapeHtml(__('Popular searches')) ?></li>
        <?php foreach ($popular as $term): ?>
            <li><a href="<?= $escaper->escapeUrl($term['url']) ?>"><?= $escaper->escapeHtml($term['title']) ?></a></li>
        <?php endforeach; ?>
    </ul>
<?php elseif ($showAllResultsLink): ?>
    <ul class="menu menu-sm w-full rounded-box border border-base-300 bg-base-100 p-2 shadow-lg"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Search suggestions')) ?>">
        <?php if ($products && $search->typosForgiven()): ?>
            <li class="<?= /* @noEscape */ $heading ?>" data-zero-search-typos>
                <?= $escaper->escapeHtml(__('Close spellings of "%1"', $query)) ?>
            </li>
        <?php endif; ?>
        <?php foreach ($products as $product): ?>
            <li>
                <a href="<?= $escaper->escapeUrl($product['url']) ?>" class="flex items-center gap-3">
                    <img src="<?= $escaper->escapeUrl($product['image']) ?>"
                         alt=""
                         loading="lazy"
                         class="size-10 shrink-0 rounded-field object-cover bg-base-200"/>
                    <span class="flex-1 min-w-0 truncate"><?= $escaper->escapeHtml($product['name']) ?></span>
                    <span class="text-base-content/60 text-xs shrink-0">
                        <?= /* @noEscape */ $product['price'] ?>
                    </span>
                </a>
            </li>
        <?php endforeach; ?>
        <?php foreach ($more as $code => $section): ?>
            <li class="<?= /* @noEscape */ $heading ?> mt-1 border-t border-base-300" data-zero-search-section="<?= $escaper->escapeHtmlAttr($code) ?>">
                <?= $escaper->escapeHtml($section['title']) ?>
            </li>
            <?php foreach ($section['items'] as $item): ?>
                <li>
                    <a href="<?= $escaper->escapeUrl($item['url']) ?>" class="flex items-baseline gap-2">
                        <span class="min-w-0 truncate"><?= $escaper->escapeHtml($item['name']) ?></span>
                        <?php if (($item['note'] ?? '') !== ''): ?>
                            <span class="text-base-content/60 text-xs truncate"><?= $escaper->escapeHtml($item['note']) ?></span>
                        <?php endif; ?>
                    </a>
                </li>
            <?php endforeach; ?>
        <?php endforeach; ?>
        <?php foreach ($suggestions as $i => $suggestion): ?>
            <li<?= ($products || $more) && $i === array_key_first($suggestions) ? ' class="mt-1 border-t border-base-300 pt-1"' : '' ?>>
                <a href="<?= $escaper->escapeUrl($suggestion['url']) ?>"
                   class="flex items-center justify-between gap-3">
                    <span><?= $escaper->escapeHtml($suggestion['title']) ?></span>
                    <?php if ($suggestion['numResults'] > 0): ?>
                        <span class="text-base-content/60 text-xs shrink-0">
                            <?= $escaper->escapeHtml($suggestion['numResults']) ?>
                        </span>
                    <?php endif; ?>
                </a>
            </li>
        <?php endforeach; ?>
        <li<?= $products || $more || $suggestions ? ' class="mt-1 border-t border-base-300 pt-1"' : '' ?>>
            <a href="<?= $escaper->escapeUrl($viewModel->getAllResultsUrl()) ?>" class="font-medium">
                <?= $escaper->escapeHtml(__('View all results for "%1"', $query)) ?>
            </a>
        </li>
    </ul>
<?php endif; ?>
